# Copy this file to `.env` and fill in real values before running docker compose.
# Never commit `.env`.

# Bootstrap admin for the master realm. Used to log into the Keycloak admin
# console at http://localhost:8080/admin on first boot. Change the password
# in the UI after first login if you want — KC_BOOTSTRAP_* are only consulted
# while the master realm has no admin yet.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-password

# Postgres credentials for the Keycloak data store.
KC_DB_PASSWORD=change-me-db-password
